# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service role key (solo servidor, NUNCA exponer al navegador)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Llave maestra (hex, 32 bytes) para descifrar el access token OAuth guardado en Supabase.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Identificador de Instagram por defecto (opcional si se envía ?user= en la petición)
INSTAGRAM_USER_ID=

# Versión de la API Graph de Instagram (opcional)
INSTAGRAM_GRAPH_VERSION=v21.0
